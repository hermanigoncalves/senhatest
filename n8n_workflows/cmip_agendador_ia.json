            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Preparar Contexto CMIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transcrever Áudio (Whisper)": {
      "main": [
        [
          {
            "node": "Preparar Contexto CMIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Contexto CMIP": {
      "main": [
        [
          {
            "node": "OpenAI Chat Model (Vick IA)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model (Vick IA)": {
      "main": [
        [
          {
            "node": "Enviar Resposta WhatsApp (Evolution Go)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
